@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

{  ?something a sh:ValidationReport
} => {
    ?something a sh:ValidationReport
}.

{   ?something a sh:ValidationReport.
    ?something sh:conforms ?egal
} => {
    ?something sh:conforms ?egal
}.

{   ?something a sh:ValidationReport.
    ?egal a sh:ValidationResult.
    ?something sh:result ?egal
} => {
    ?something sh:result ?egal
}.

{   ?something a sh:ValidationReport.
    ?egal a sh:ValidationResult.
    ?something sh:result ?egal.
    ?egal ?pred ?obj.
    ?pred log:notEqualTo sh:resultMessage.
    ?pred log:notEqualTo sh:resultSeverity.
} => {
    ?egal ?pred ?obj.
}.
##mes
{   ?something a sh:ValidationReport.
    ?egal a sh:ValidationResult.
    ?something sh:result ?egal.
    ?egal ?pred ?message.
    ?pred log:equalTo sh:resultMessage.
    :ShapeGot :Message ?list. #(?shape ?message)
    ?list list:last ?message.
} => {
    ?egal ?pred ?message.
}.

{   ?something a sh:ValidationReport.
    ?egal a sh:ValidationResult.
    ?something sh:result ?egal.
    ?egal ?pred ?obj.
    ?pred log:equalTo sh:resultMessage.
    _:b log:notIncludes {:ShapeGot :Message ?list.}.
} => {
    ?egal ?pred ?obj.
}.

##sev
{   ?something a sh:ValidationReport.
    ?egal a sh:ValidationResult.
    ?something sh:result ?egal.
    ?egal ?pred ?sev.
    ?pred log:equalTo sh:resultSeverity.
    :ShapeGot :Severity ?list. #(?shape ?sev)
    ?list list:last ?sev.
} => {
    ?egal ?pred ?sev.
}.

{   ?something a sh:ValidationReport.
    ?egal a sh:ValidationResult.
    ?something sh:result ?egal.
    ?egal ?pred ?obj.
    ?pred log:equalTo sh:resultSeverity.
    _:b log:notIncludes {:ShapeGot :Severity ?list.}.
} => {
    ?egal ?pred ?obj.
}.