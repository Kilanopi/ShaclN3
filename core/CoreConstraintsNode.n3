#------String-based Constraints
#---minLength
{	?shape 	sh:minLength 	?value.
	_:shaclScope log:notIncludes {?shape sh:path _:something}.
} => {
	{	?shape :targets ?i.
		("Node has less than " ?value " characters") string:concatenation ?message. 
		:testPos :literal ?i.
		(?something ?testType) log:dtlit ?i.
		?testType log:localN3String ?typeString.
		?typeString string:containsRoughly "string".
		?i string:length ?llength.
		?llength math:lessThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinLengthConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message].
	}.
	##########################
	{	?shape :targets ?i. 
		("Node has less than " ?value " characters") string:concatenation ?message. 
		:testPos :literal ?i.
		(?something ?testType) log:dtlit ?i.
		?testType log:localN3String ?typeString.
		?typeString string:notContainsRoughly "string".
		?i log:localN3String ?testString.
		?testString string:length ?llength.
		?llength math:lessThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinLengthConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	##########################
	{	?shape :targets ?i. 
		("Node has less than " ?value " characters") string:concatenation ?message. 
		:testPos :iri ?i.
		?i log:uri ?testString.
		?testString string:length ?llength.
		?llength math:lessThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinLengthConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	##########################
	?shape :needs :Nodekind.
	##########################
	{	?shape :targets ?i. 
		("Node has less than " ?value " characters") string:concatenation ?message. 
		:testNeg :literal ?i.
		:testNeg :iri ?i.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinLengthConstraintComponent;
			sh:sourceShape 					?shape; 
			sh:value 						?i;
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}
}.	

#---maxLength
{	?shape 	sh:maxLength 	?value.
	_:shaclScope log:notIncludes {?shape sh:path _:something}.
} => {
	{	?shape :targets ?i. 
		("Node has more than " ?value " characters") string:concatenation ?message. 
		:testPos :literal ?i.
		(?something ?testType) log:dtlit ?i.
		?testType log:localN3String ?typepe.
		?typepe string:containsRoughly "string".
		?i string:length ?llength.
		?llength math:greaterThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MaxLengthConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message].
	}.
	##########################
	{	?shape :targets ?i. 
		("Node has more than " ?value " characters") string:concatenation ?message. 
		:testPos :literal ?i.
		(?something ?testType) log:dtlit ?i.
		?testType log:localN3String ?typepe.
		?typepe string:notContainsRoughly "string".
		?i log:localN3String ?testme.
		?testme string:length ?llength.
		?llength math:greaterThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MaxLengthConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	##########################
	{	?shape :targets ?i. 
		("Node has more than " ?value " characters") string:concatenation ?message. 
		:testPos :iri ?i.
		?i log:uri ?testme.
		?testme string:length ?llength.
		?llength math:greaterThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MaxLengthConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	##########################
	?shape :needs :Nodekind.
	##########################
	{	?shape :targets ?i. 
		("Node has more than " ?value " characters") string:concatenation ?message. 
		:testNeg :literal ?i.
		:testNeg :iri ?i.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MaxLengthConstraintComponent;
			sh:sourceShape 					?shape; 
			sh:value 						?i;
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}
}.
#---pattern
{	?shape 	sh:pattern 	?regex.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	?shape :needs :Nodekind.
	#########################
	{	?shape :targets ?i. 
		("Node does not match pattern " ?regex) string:concatenation ?message.
		:testNeg :literal ?i.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:PatternConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
}.
{	?shape 	sh:pattern 	?regex.
	_:shaclScope log:notIncludes {?shape sh:path _:something}.
	_:shaclScope log:notIncludes {?shape sh:flags _:flag}.
} => {
	{	?shape :targets ?i. 
		("Node does not match pattern " ?regex) string:concatenation ?message.
		(?data ?type) log:dtlit ?i.
		?data string:notMatches ?regex.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:PatternConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
}.	
{	?shape 	sh:pattern 	?regex;
			sh:flags "i".
	_:shaclScope log:notIncludes {?shape sh:path _:egal}.
} => {
	{	?shape :targets ?i. 
		("Node does not match pattern " ?regex) string:concatenation ?message.
		(?data ?type) log:dtlit ?i.
		?data string:lowerCase ?ldata.
		?regex string:lowerCase ?lregex.
		?ldata string:notMatches ?lregex
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:PatternConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
}.	
#---languageIn
{	?shape 	sh:languageIn 	?list.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i. 
		(?egal ?tag) log:langlit ?i. 
		?list list:iterate (?index ?value). 
		("^(" ?value "-+.*)|(" ?value ")$") string:concatenation ?regex.				# ^(?value-+.*)|(?value)$ 
		?tag string:matches ?regex
	} => {
		:NodeShape :langPos (?i ?list)
	}.
	##############################	
	{	?shape :targets ?i. 
		("Language does not match any of " ?list) string:concatenation ?message. 
		_:dataScope log:notIncludes {:NodeShape :langPos (?i ?list)}
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:LanguageInConstraintComponent; 
			sh:sourceShape 					?shape ;
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}
}.	
#------Property Pair Constraints
#---equals
{	?shape 	sh:equals 	?value.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i. 
		("Must have the same values as " ?value) string:concatenation ?message. 
		_:dataScope log:notIncludes {?i ?value ?i}
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:EqualsConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	{	?shape :targets ?i. 
		("Must have the same values as " ?value) string:concatenation ?message. 
		?i ?value ?i.
		?i ?value ?otherNode.
		?otherNode log:notEqualTo ?i.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:EqualsConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i; 
			sh:value 						?otherNode;
			sh:resultMessage 				?message]
	}.
}.	
#---disjoint
{	?shape 	sh:disjoint ?value.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i. 
		("Node must not also be one of the values of " ?value) string:concatenation ?message. 
		?i ?value ?i
		} => {
			[	a 								sh:ValidationResult; 
				sh:resultSeverity 				sh:Violation; 
				sh:sourceConstraintComponent 	sh:DisjointConstraintComponent; 
				sh:sourceShape 					?shape;
				sh:focusNode 					?i; 
				sh:value 						?i;
				sh:resultMessage 				?message]
	}
}.	
#------Shape-based Constraints
#---node
{	?shape 	sh:node ?vshape.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i
	} => {
		?vshape :targets ?i
	}.
	####################################
	{	?shape :targets ?i. 
		?vshape sh:property ?pShape.
		?violation 	sh:sourceShape 	?pShape; 
					sh:focusNode 	?i
	} => {
		:NodeShape :node (?i ?vshape ?violation)
	}.
	####################################
	{	?shape :targets ?i. 
		?vshape sh:property ?pShape.
		:NodeShape :prop (?i ?pShape ?violation)
	} => {
		:NodeShape :node (?i ?vshape ?violation)
	}.
	####################################
	{	?shape :targets ?i. 
		?violation 	sh:sourceShape 	?vshape; 
					sh:focusNode 	?i
	} => {
		:NodeShape :node (?i ?vshape ?violation)
	}.
	###################################
	{	?shape :targets ?i. 
		("Node does not have shape " ?vshape) string:concatenation ?message. 
		:NodeShape :node (?i ?vshape ?anyViolation)
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i;
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	##################################
	{	?shape :targets ?i. 
		("Node does not have shape " ?vshape) string:concatenation ?message. 
		?result a 					sh:ValidationResult; 
				sh:focusNode 		?i; 
				sh:resultMessage 	?message. 
		:NodeShape :node (?i ?vshape ?violation)
	} => {
		?result sh:detail ?violation
	}
}.
#---property
{	?shape 	sh:property ?pShape.
    ?pShape sh:path ?prop.
	_:shaclScope log:notIncludes {?shape sh:path ?gg}
} => {
	?shape :hasPChild (?pShape ?prop).
	{	?shape 	:targets 	?i
	} => {
		?pShape :targets 	?i
	}.
	############################
	{	?shape 	:targets 	?i. 
		?violation 	sh:sourceShape 	?pShape; 
					sh:focusNode 	?i
	} => {
		:NodeShape :prop (?i ?pShape ?violation)
	}.
	#############################
	{	?shape 	:targets 	?i.
		?pShape :hasPChild (?vShape ?prop2).
		:PropShape :prop (?i ?vShape ?violation)
	} => {
		:NodeShape :prop (?i ?pShape ?violation)
	}.
	##############################
	{	?shape :hasPChild (?pShape ?prop).
		?as :apply :clean.
	} => {
		?shape :hasApplyPChild (?pShape ?prop).
	}.
}.

#---hasValue												
{	?shape 	sh:hasValue ?value.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
	} => {
		{	?shape :targets ?i. 
			("Node must be " ?value) string:concatenation ?message. 
			?i log:notEqualTo ?value
		} => {
			[ 	a 								sh:ValidationResult; 
				sh:resultSeverity	 			sh:Violation; 
				sh:sourceConstraintComponent 	sh:HasValueConstraintComponent; 
				sh:sourceShape 					?shape;
				sh:focusNode 					?i; 
				sh:resultMessage 				?message]
		}
}.
#---in
{	?shape 	sh:in 	?list.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i. 
		?i list:in ?list
	} => {
		:NodeShape :lPos (?i ?list)
	}.
	###########################
	{	?shape :targets ?i. 
		("Node is not in " ?list) string:concatenation ?message. 
		_:dataScope log:notIncludes {:NodeShape :lPos (?i ?list)}
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:InConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}
}.
#------Logical Constraints
#---and
{	?shape 	sh:and 	?list.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i.   
		?list list:iterate (?index ?value).		 
		?violation  sh:sourceShape ?value;
                    sh:focusNode   ?i. 
	} => {
		:NodeShape :and (?index ?i ?list).
	}.
	#################################
	{	?shape :targets ?i.   
		?list list:iterate (?index ?value).		 
		?value :hasPChild (?pShape ?prop).
		:PropShape :prop (?i ?pShape ?violation)
	} => {
		:NodeShape :and (?index ?i ?list).
	}.
	#################################
	{	?shape :targets ?i.   
		?list list:iterate (?index ?value).	
		?value :hasPChild (?pShape ?prop).
		:NodeShape :prop (?i ?pShape ?violation) 
	} => {
		:NodeShape :and (?index ?i ?list).
	}.
	#################################
    {   ?shape :targets ?i.   
        (?value {:NodeShape :and (?value ?i ?list).} ?vlist) log:collectAllIn ?scope.  
        ?vlist list:length ?vlength.
        ?vlength math:greaterThan 0
    } => {
        [ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:AndConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i]
    }.
	#####################
	{	?shape :targets ?i.
		?list list:iterate (?index ?value) 
	} => {
		?value :targets ?i
	}
}.
#---or
{	?shape 	sh:or 	?list.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i.   
		?list list:iterate (?index ?value).		 
		?violation  sh:sourceShape ?value;
                    sh:focusNode   ?i. 
	} => {
		:NodeShape :or (?index ?i ?list).
	}.
	#################################
	{	?shape :targets ?i.   
		?list list:iterate (?index ?value).		
		?value :hasPChild (?pShape ?prop).
		:NodeShape :prop (?i ?pShape ?violation)
	} => {
		:NodeShape :or (?index ?i ?list).
	}.
	#################################
	{	?shape :targets ?i.   
		?list list:iterate (?index ?value).	
		?value :hasPChild (?pShape ?prop).
		:PropShape :prop (?i ?pShape ?violation) 	 
	} => {
		:NodeShape :or (?index ?i ?list).
	}.
    #################################
    {   ?shape :targets ?i.   
        (?value {:NodeShape :or (?value ?i ?list).} ?vlist) log:collectAllIn ?scope. 
        ?vlist list:length ?vlength.
        ?list list:length ?llength.
        ?vlength math:equalTo ?llength
    } => {
        [ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:OrConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i]
    }.
	#####################
	{	?shape :targets ?i.
		?list list:iterate (?index ?value) 
	} => {
		?value :targets ?i
	}
}.
#---xone
{	?shape 	sh:xone 	?list.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i.   
		?list list:iterate (?index ?value).		 
		?violation  sh:sourceShape ?value;
                    sh:focusNode   ?i. 
	} => {
		:NodeShape :xone (?index ?i ?list).
	}.
	#################################
	{	?shape :targets ?i.   
		?list list:iterate (?index ?value).		 
		?value :hasPChild (?pShape ?prop).
		:PropShape :prop (?i ?pShape ?violation) 
	} => {
		:NodeShape :xone (?index ?i ?list).
	}.
	#################################
	{	?shape :targets ?i.   
		?list list:iterate (?index ?value).		
		?value :hasPChild (?pShape ?prop).
		:NodeShape :prop (?i ?pShape ?violation).
	} => {
		:NodeShape :xone (?index ?i ?list).
	}.
    #################################
    {   ?shape :targets ?i.   
        (?value {:NodeShape :xone (?value ?i ?list).} ?vlist) log:collectAllIn ?scope. 
        ?vlist list:length ?vlength.
        ?list list:length ?llength.
        ?vlength math:equalTo ?llength
    } => {
        [ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:XoneConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i]
    }.
	#################################
    {   ?shape :targets ?i.   
        (?value {:NodeShape :xone (?value ?i ?list).} ?vlist) log:collectAllIn ?scope. 
        ?vlist list:length ?vlength.
        ?list list:length ?llength.
        (?llength -1) math:sum ?mllength.
        ?vlength math:lessThan ?mllength
    } => {
        [ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:XoneConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i]
    }.
	#####################
	{	?shape :targets ?i.
		?list list:iterate (?index ?value) 
	} => {
		?value :targets ?i
	}
}.
#---closed
{	?shape 	sh:closed true.
	_:shaclScope log:notIncludes {?shape sh:path _:something}.
    _:shaclScope log:notIncludes {?shape sh:ignoredProperties ?list}.
    (?props {?shape	sh:property ?value.
             ?value	sh:path   	?props      } ?plist) log:collectAllIn ?scope.
} => {
	{	?shape :targets ?i.
    	?i ?tprop ?something.
    	?plist list:member ?tprop.
    }=>{
      	:NodeShape :closed (?plist ?i ?tprop)
    }.
  ########################
  	{	?shape :targets ?i.
    	?i ?tprop ?something.
    	_:dataScope log:notIncludes {:NodeShape :closed (?plist ?i ?tprop)}
    }=>{
      	[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:ClosedConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?something;
			sh:resultPath 					?tprop]
   	}
}.
################################################################
{	?shape 	sh:closed true;
    		sh:ignoredProperties ?list.
	_:shaclScope log:notIncludes {?shape sh:path _:something}.
    (?props {?shape	sh:property ?value.
             ?value	sh:path   	?props      } ?vplist) log:collectAllIn ?scope.
    (?vplist ?list) list:append ?plist.
} => {
	{	?shape :targets ?i.
    	?i ?tprop ?something.
    	?plist list:member ?tprop.
    }=>{
      	:NodeShape :closed (?plist ?i ?tprop)
    }.
  ########################
  	{	?shape :targets ?i.
    	?i ?tprop ?something.
    	_:dataScope log:notIncludes {:NodeShape :closed (?plist ?i ?tprop)}
    }=>{
      	[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:ClosedConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?something;
			sh:resultPath 					?tprop;]
   	} 
}.