@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix func: <http://www.w3.org/2007/rif-builtin-function#>.

#---on-demand Nodekind determination 
{
} => {
	{	?shape :needs :Nodekind.
		_:shaclScope log:notIncludes {?shape sh:path _:something}.
		_:shaclScope log:notIncludes {:please :apply :clean}
	} => {
		{	?shape :targets ?i.
			?i log:rawType log:Literal
		} => {
			:testPos :literal ?i.
			:testNeg :iri ?i.
			:testNeg :blanknode ?i.
		}.
		###############
		{	?shape :targets ?i.
			?i log:rawType log:Other
		} => {
			:testNeg :literal ?i.
			:testPos :iri ?i.
			:testNeg :blanknode ?i.
		}.
		###############
		{	?shape :targets ?i.
			?i log:rawType log:UnlabeledBlankNode
		} => {
			:testNeg :literal ?i.
			:testNeg :iri ?i.
			:testPos :blanknode ?i.
		}.
		###############
		{	?shape :targets ?i.
			?i log:rawType log:ForAll
		} => {
			:testNeg :literal ?i.
			:testNeg :iri ?i.
			:testPos :blanknode ?i.
		}.
		###############
		{	?shape :targets ?i.
			?i log:rawType log:LabeledBlankNode
		} => {
			:testNeg :literal ?i.
			:testNeg :iri ?i.
			:testPos :blanknode ?i.
		}.
		###############
		{	?shape :targets ?i.
			?i log:rawType log:SkolemIRI
		} => {
			:testNeg :literal ?i.
			:testNeg :iri ?i.
			:testPos :blanknode ?i.
		}.
	}
}.
#--------Core Constraint Components
#------Value Type Constraints
#---class
{	?shape	sh:class	?class.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i.
		("Node does not have class " ?class) string:concatenation ?message.
		_:dataScope log:notIncludes {?i rdf:type ?class}
	} => {
		[	a								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:ClassConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:value						?i;
			sh:resultMessage				?message]
	}
}.
#---datatype 
{	?shape sh:datatype ?type.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i.
		("Node does not have datatype " ?type) string:concatenation ?message.
		(?data ?testType) log:dtlit ?i.
		?testType log:notEqualTo ?type
	} => {
		[	a								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:value						?i;
			sh:resultMessage				?message]
	}.
	###########################################
	?shape :needs :Nodekind.
	##########################################
	{	?shape :targets ?i.
		("Node does not have datatype " ?type) string:concatenation ?message.
		:testNeg :literal ?i.
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:value						?i;
			sh:resultMessage				?message]
	}.
	########################################## Taken from eye/reasoning/ill-formed-literals
	{	?shape :targets ?i.
  		?i log:rawType log:Literal.
  		(?lex xsd:boolean) log:dtlit ?i.
  		?lex string:notMatches "^(true|false|1|0)$".
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:value						?i].
	}.
	##############
	{	?shape :targets ?i.
  		?i log:rawType log:Literal.
  		(?lex ?dt) log:dtlit ?i.
  		?dt list:in (
      	xsd:integer
      	xsd:long
      	xsd:int
      	xsd:short
      	xsd:nonNegativeInteger
      	xsd:positiveInteger
      	xsd:nonPositiveInteger
      	xsd:negativeInteger
      	xsd:unsignedLong
      	xsd:unsignedInt
      	xsd:unsignedShort
      	xsd:unsignedByte ).
  		?lex string:notMatches "^[+-]?[0-9]+$".
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:value						?i].
	}.
		##############
	{	?shape :targets ?i.
  		?i log:rawType log:Literal.
  		(?lex xsd:byte) log:dtlit ?i.
  		?lex string:notMatches "^(-128|-?(12[0-7]|1[01][0-9]|[1-9]?[0-9]|0))$".
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:value						?i].
	}.
	##############
	{	?shape :targets ?i.
  		?i log:rawType log:Literal.
		(?lex xsd:decimal) log:dtlit ?i.
  		?lex string:notMatches "^[+-]?(?:[0-9]+\\.[0-9]*|\\.[0-9]+|[0-9]+)$".
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:value						?i].
	}.
	##############
	{	?shape :targets ?i.
  		?i log:rawType log:Literal.
		(?lex ?dt) log:dtlit ?i.
  		?dt list:in ( xsd:float xsd:double ).
  		?lex string:notMatches "^(?:NaN|INF|-INF|[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)$".
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:value						?i].
	}.
	##############
	{	?shape :targets ?i.
  		?i log:rawType log:Literal.
		(?lex ?dt) log:dtlit ?i.
  		?dt list:in ( xsd:date xsd:dateTime xsd:duration ).
  		1 log:notIncludes { ?i math:equalTo ?i. }.
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:value						?i].
	}.
}.
#---nodeKind
{	?shape 	sh:nodeKind ?kind.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	?shape :needs :Nodekind.
	################################
	{	?shape :targets ?i. 
		("Node does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:Literal.
		:testNeg :literal ?i.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		("Node does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:BlankNode.
		:testNeg :blanknode ?i
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		("Node does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:IRI.
		:testNeg :iri ?i
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		("Node does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:BlankNodeOrLiteral.
		:testPos :iri ?i
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		("Node does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:IRIOrLiteral.
		:testPos :blanknode ?i
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		("Node does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:BlankNodeOrIRI.
		:testPos :literal ?i
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:value 						?i;
			sh:resultMessage 				?message]
	}.
}.
#------Value Range Constraints
#---minInclusive
{	?shape 	sh:minInclusive ?value.
	_:shaclScope log:notIncludes {?shape sh:path _:something}
} => {
	{	?shape :targets ?i. 
		("Node is not >= " ?value) string:concatenation ?message. 
		?i log:rawType log:Literal.
  		(?lex xsd:dateTime) log:dtlit ?i.
		(?i ?value) func:subtract-dateTimes ?result.
		?result string:startsWith "-".
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?i;
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}.
	##########################
	{	?shape :targets ?i. 
		("Node is not >= " ?value) string:concatenation ?message. 
		?i log:rawType log:Literal.
  		_:dataScope log:notIncludes {(?lex xsd:dateTime) log:dtlit ?i}.
		?i math:lessThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?i;
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}.
	##########################
	?shape :needs :Nodekind.
	##########################
	{	?shape :targets ?i. 
		("Node is not > " ?value) string:concatenation ?message. 
		:testPos :literal ?i.
		_:dataScope log:notIncludes {?i math:equalTo ?i.}.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?i;
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}.
	#########################
	{	?shape :targets ?i. 
		("Node is not >= " ?value) string:concatenation ?message. 
		:testNeg :literal ?i
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?i;
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}
}.
