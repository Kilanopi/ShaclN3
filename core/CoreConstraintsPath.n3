#------------------Pathverarbeitung
#---Predicate
{	:PropShape :PathVererbung (?shape ?parent ?prop 0).
    ?prop list:isList false.
    _:shaclScope log:notIncludes {?prop sh:alternativePath _:egal},
                                 {?prop sh:inversePath _:egal},
                                 {?prop sh:zeroOrMorePath _:egal},
                                 {?prop sh:oneOrMorePath _:egal},
                                 {?prop sh:zeroOrOnePath _:egal}.
} => {
	{	?shape  :targets 	?i.
        ?i ?prop ?toTest.
 	} => {
		:PropShape :Pathverarbeitung (?shape ?i ?parent ?i ?prop ?toTest)
	}.
}.
##############################
{	:PropShape :PathVererbung (?shape ?parent ?prop ?depth).
    ?depth math:greaterThan 0.
    ?prop list:isList false.
    _:shaclScope log:notIncludes {?prop sh:alternativePath _:egal},
                                 {?prop sh:inversePath _:egal},
                                 {?prop sh:zeroOrMorePath _:egal},
                                 {?prop sh:oneOrMorePath _:egal},
                                 {?prop sh:zeroOrOnePath _:egal}.
} => {
	{	?shape  :targets 	?i.
        ?i ?prop ?toTest.
 	} => {
		:PropShape :Pathing (?shape ?i ?parent ?i ?prop ?toTest)
	}.
    ##########
    {	?shape  :targets 	?i.
        :PropShape :Pathing (?shape ?i ?parent ?egal1 ?egal2 ?toTest).
        ?toTest ?prop ?toTestTest.
 	} => {
		:PropShape :Pathing (?shape ?i ?parent ?toTest ?prop ?toTestTest)
	}
}.
##############################inv
{	:PropShape :PathIVererbung (?shape ?parent ?prop ?depth).
    ?depth math:greaterThan 0.
    ?prop list:isList false.
    _:shaclScope log:notIncludes {?prop sh:alternativePath _:egal},
                                 {?prop sh:inversePath _:egal},
                                 {?prop sh:zeroOrMorePath _:egal},
                                 {?prop sh:oneOrMorePath _:egal},
                                 {?prop sh:zeroOrOnePath _:egal}.
} => {
    ######### case first
	{	?shape  :targets 	?i.
        ?toTest ?prop ?i.
 	} => {
		:PropShape :Pathing (?shape ?i ?parent ?i ?prop ?toTest)
	}.
    ########## case not first
    {	?shape  :targets 	?i.
        :PropShape :Pathing (?shape ?i ?parent ?egal1 ?egal2 ?toTest).
        ?toTestTest ?prop ?toTest.
 	} => {
		:PropShape :Pathing (?shape ?i ?parent ?toTest ?prop ?toTestTest)
	}
}.
#---Sequence
{	:PropShape :PathVererbung (?shape ?parent ?proplist 0).
    ?proplist list:isList true.
} => {
    ######### Base case
	{	?shape  :targets 	?i.
 	} => {
		:PropShape :Seqverarbeitung (?shape ?i ?proplist ?i ?proplist).
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :Seqverarbeitung (?shape ?i ?proplist ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
        (_:dataScope 0) log:notIncludes {?rest list:length 0}.
        
 	} => {
		:PropShape :Seqverarbeitung (?shape ?i ?proplist ?toTest ?rest)
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :Seqverarbeitung (?shape ?i ?proplist ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        ?rest list:length 0.
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
 	} => {
        :PropShape :Pathverarbeitung (?shape ?i ?parent ?i ?proplist ?toTest).
	}.
}.
#########################################
{	:PropShape :PathVererbung (?shape ?parent ?proplist ?depth).
    ?proplist list:isList true.
    ?depth math:greaterThan 0.
} => {
    ######### case first
	{	?shape  :targets 	?i.
 	} => {
		:PropShape :Seqverarbeitung (?shape ?i ?proplist ?i ?proplist).
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :Seqverarbeitung (?shape ?i ?proplist ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
        (_:dataScope 0) log:notIncludes {?rest list:length 0}
        
 	} => {
		:PropShape :Seqverarbeitung (?shape ?i ?proplist ?toTest ?rest)
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :Seqverarbeitung (?shape ?i ?proplist ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        ?rest list:length 0.
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
 	} => {
        :PropShape :Pathing (?shape ?i ?parent ?i ?proplist ?toTest).
	}.
    ########################
    ######### case not first
	{	?shape  :targets 	?i.
        :PropShape :Pathing (?shape ?i ?parent ?egal1 ?egal2 ?toTest).
 	} => {
		:PropShape :SeqNFverarbeitung (?shape ?i ?proplist ?toTest ?toTest ?proplist).
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :SeqNFverarbeitung (?shape ?i ?proplist ?origin ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
        (_:dataScope 0) log:notIncludes {?rest list:length 0}
        
 	} => {
		:PropShape :SeqNFverarbeitung (?shape ?i ?proplist ?origin ?toTest ?rest)
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :SeqNFverarbeitung (?shape ?i ?proplist ?origin ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        ?rest list:length 0.
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
 	} => {
        :PropShape :Pathing (?shape ?i ?parent ?origin ?proplist ?toTest).
	}.
}.

#########################################inv
{	:PropShape :PathIVererbung (?shape ?parent ?plist ?depth).
    ?proplist list:isList true.
    ?depth math:greaterThan 0.
    ?plist list:reverse ?proplist.
} => {
    ######### case first
	{	?shape  :targets 	?i.
 	} => {
		:PropShape :Seqverarbeitung (?shape ?i ?proplist ?i ?proplist).
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :Seqverarbeitung (?shape ?i ?proplist ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
        (_:dataScope 0) log:notIncludes {?rest list:length 0}
        
 	} => {
		:PropShape :Seqverarbeitung (?shape ?i ?proplist ?toTest ?rest)
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :Seqverarbeitung (?shape ?i ?proplist ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        ?rest list:length 0.
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
 	} => {
        :PropShape :Pathing (?shape ?i ?parent ?i ?plist ?toTest).
	}.
    ########################
    ######### case not first
	{	?shape  :targets 	?i.
        :PropShape :Pathing (?shape ?i ?parent ?egal1 ?egal2 ?toTest).
 	} => {
		:PropShape :SeqNFverarbeitung (?shape ?i ?proplist ?toTest ?toTest ?proplist).
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :SeqNFverarbeitung (?shape ?i ?proplist ?origin ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
        (_:dataScope 0) log:notIncludes {?rest list:length 0}
        
 	} => {
		:PropShape :SeqNFverarbeitung (?shape ?i ?proplist ?origin ?toTest ?rest)
	}.
    #####################
    {	?shape  :targets 	?i.
        :PropShape :SeqNFverarbeitung (?shape ?i ?proplist ?origin ?somenode ?somelist).
        ?somelist list:firstRest (?prop ?rest).
        ?rest list:length 0.
        :PropShape :Pathing (?shape ?i ?parent ?somenode ?prop ?toTest).
 	} => {
        :PropShape :Pathing (?shape ?i ?parent ?origin ?plist ?toTest).
	}.
}.


