@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix func: <http://www.w3.org/2007/rif-builtin-function#>.


#------------------Pathvererbung rememberer
#--------Base case
{	?shape sh:path ?prop.
} => {
    :PropShape :PathVererbung (?shape ?prop ?prop 0) 
}.

#---Sequence
{   :PropShape :PathVererbung (?shape ?parent ?proplist ?depth).
    ?proplist list:isList true.
    ?proplist list:firstRest (?prop ?rest).
    (?depth 1) math:sum ?ndepth.
} => {
    :PropShape :PathVererbung (?shape ?parent ?prop ?ndepth).
    :PropShape :PathSeqVererbung (?shape ?parent ?rest ?ndepth)
}.
{   :PropShape :PathSeqVererbung (?shape ?parent ?proplist ?depth).
    ?proplist list:firstRest (?prop ?rest).
    _:shaclScope log:notIncludes {?rest list:length 0}.
} => {
    :PropShape :PathVererbung (?shape ?parent ?prop ?depth).
    :PropShape :PathSeqVererbung (?shape ?parent ?rest ?depth)
}.
{   :PropShape :PathSeqVererbung (?shape ?parent ?proplist ?depth).
    ?proplist list:firstRest (?prop ?rest).
    ?rest list:length 0.
} => {
    :PropShape :PathVererbung (?shape ?parent ?prop ?depth).
}.
#---Alternative
{   :PropShape :PathVererbung (?shape ?parent ?propB ?depth).
    ?propB sh:alternativePath ?list.
    ?list list:iterate (?index ?prop).
    (?depth 1) math:sum ?ndepth.
} => {
    :PropShape :PathVererbung (?shape ?parent ?prop ?ndepth).
}.
#---Inverse
{   :PropShape :PathVererbung (?shape ?parent ?propB ?depth).
    ?propB sh:inversePath ?path.
    (?depth 1) math:sum ?ndepth.
} => {
    :PropShape :PathIVererbung (?shape ?parent ?path ?ndepth).
}.

#---Zero-Or-More
{   :PropShape :PathVererbung (?shape ?parent ?propB ?depth).
    ?propB sh:zeroOrMorePath ?path.
    (?depth 1) math:sum ?ndepth.
} => {
    :PropShape :PathVererbung (?shape ?parent ?path ?ndepth).
}.

#---One-Or-More
{   :PropShape :PathVererbung (?shape ?parent ?propB ?depth).
    ?propB sh:oneOrMorePath ?path.
    (?depth 1) math:sum ?ndepth.
} => {
    :PropShape :PathVererbung (?shape ?parent ?path ?ndepth).
}.
#---Zero-Or-One
{   :PropShape :PathVererbung (?shape ?parent ?propB ?depth).
    ?propB sh:zeroOrOnePath ?path.
    (?depth 1) math:sum ?ndepth.
} => {
    :PropShape :PathVererbung (?shape ?parent ?path ?ndepth).
}.
##########################inverses
