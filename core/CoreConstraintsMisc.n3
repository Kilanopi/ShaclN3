@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .


#--------Misc Components
#---deactivated
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

{	?shape sh:deactivated true.
} => {
	{	?shape :targets ?i.
 	} => {
		:ShapeGot :Deactivated ?shape.
	}
}.
#---message
{	?shape sh:message ?message.
} => {
	{	?shape :targets ?i.
 	} => {
		:ShapeGot :Message (?shape ?message).
	}
}.
#---severity
{	?shape sh:severity ?sev.
} => {
	{	?shape :targets ?i.
 	} => {
		:ShapeGot :Severity (?shape ?sev).
	}
}.
