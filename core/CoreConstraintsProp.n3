#------Shape-based Constraints
#---node
{	?shape 	sh:path ?prop; 
			sh:node ?vshape.
} => {
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
	} => {
		?vshape :targets ?toTest
	}.
	####################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?vshape sh:property ?pShape.
		?violation 	sh:sourceShape 	?pShape; 
					sh:focusNode 	?toTest
	} => {
		:PropShape :node (?toTest ?vshape ?violation)
	}.
	####################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		:NodeShape :prop (?toTest ?vShape ?violation)
	} => {
		:PropShape :node (?toTest ?vshape ?violation)
	}.
	####################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?vshape sh:property ?pShape.
		:PropShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :node (?toTest ?vshape ?violation)
	}.
	####################################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?violation 	sh:sourceShape 	?vshape; 
					sh:focusNode 	?toTest
	} => {
		:PropShape :node (?toTest ?vshape ?violation)
	}.
	###################################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have shape " ?vshape) string:concatenation ?message. 
		:PropShape :node (?toTest ?vshape ?anyViolation)
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent	sh:NodeConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode					?i;
			sh:resultPath					?prop; 
			sh:value						?toTest;
			sh:resultMessage				?message]
	}.
	##################################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have shape " ?vshape) string:concatenation ?message. 
		?result a 					sh:ValidationResult; 
				sh:focusNode 		?i; 
				sh:resultMessage 	?message. 
		:PropShape :node (?toTest ?vshape ?violation)
	} => {
		?result sh:detail ?violation
	}
}.
#---property
{	?shape 	sh:path 	?prop; 
			sh:property ?pShape.
	?pShape sh:path ?prop2.
} => {
	?shape :hasPChild (?pShape ?prop2).
	{	?shape 	:targets 	?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
	} => {
		?pShape :targets 	?toTest
	}.
	############################
	{	?shape 	:targets 	?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?violation 	sh:sourceShape 	?pShape; 
					sh:focusNode 	?toTest
	} => {
		:PropShape :prop (?toTest ?pShape ?violation)
	}.
	#############################
	{	?shape 	:targets 	?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?pshape :hasPChild (?vShape ?prop3).
		:PropShape :prop (?toTest ?vShape ?violation)
	} => {
		:PropShape :prop (?toTest ?pShape ?violation)
	}.
	#############################
	{	?shape :hasPChild (?pShape ?prop2).
		?as :apply :clean.
	} => {
		?shape :hasApplyPChild (?pShape ?prop2).
	}.
}.

#---qualified min/maxcount
{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape
} => {
	{	?shape 	:targets 	?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
	} => {
		?qShape :targets 	?toTest
	}.	
########################
	{	?shape :targets ?i.   
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest). 
		?violation  sh:sourceShape ?qShape;
					sh:focusNode   ?toTest. 
	} => {
		:PropShape :qShape (?i ?qShape ?toTest).
	}.
#################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).	 
		?qShape :hasPChild (?pShape ?prop2).
		:PropShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :qShape (?i ?qShape ?toTest).
	}.
#################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).	 
		?qShape :hasPChild (?pShape ?prop2).
		:NodeShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :qShape (?i ?qShape ?toTest).
	}.
}.
########################
{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape;
			sh:qualifiedMinCount ?min.
	_:shac log:notIncludes {?shape sh:qualifiedValueShapesDisjoint true}.
} => {
	{	(_:dataScope 2) log:includes {?shape 	:targets 	?i.}.
		("Less than " ?min " values have shape " ?qShape) string:concatenation ?message. 
		(?toTest {:PropShape :PathCommunication (?shape ?i ?prop ?toTest).} ?plist) log:collectAllIn ?scope. 
		(?toTest {:PropShape :qShape (?i ?qShape ?toTest).} ?vlist) log:collectAllIn ?scope. 
		?plist list:length ?lplist.
		?vlist list:length ?lvlist.
		?lvlist math:negation ?nlvlist.
		(?lplist ?nlvlist) math:sum ?over.
		?over math:lessThan ?min.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:QualifiedMinCountConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:value 						?plist;
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}.
}.	
########################
{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape;
			sh:qualifiedMaxCount ?max.
	_:shac log:notIncludes {?shape sh:qualifiedValueShapesDisjoint true}.
} => {
	{	(_:dataScope 2) log:includes {?shape 	:targets 	?i.}.
		("More than " ?max " values have shape " ?qShape) string:concatenation ?message. 
		(?toTest {:PropShape :PathCommunication (?shape ?i ?prop ?toTest).} ?plist) log:collectAllIn ?scope. 
		(?toTest {:PropShape :qShape (?i ?qShape ?toTest).} ?vlist) log:collectAllIn ?scope. 
		?plist list:length ?lplist.
		?vlist list:length ?lvlist.
		?lvlist math:negation ?nlvlist.
		(?lplist ?nlvlist) math:sum ?over.
		?over math:greaterThan ?max.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:QualifiedMaxCountConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:value 						?plist;
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}.
}.	
##########################################disjoint
{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape;
			sh:qualifiedValueShapesDisjoint true.
	?pShape sh:property ?shape.
	(?otherShape {	?pShape sh:property ?otherqShape.
					?otherqShape sh:qualifiedValueShape ?otherShape.
					?qShape log:notEqualTo ?otherShape} ?siblist) log:collectAllIn ?scope. 
	
} => {
	:PropShape :hasSiblings (?pShape ?qShape ?siblist)
}.
#########################case father
{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape;
			sh:qualifiedValueShapesDisjoint true.
	?pShape sh:property ?shape.
	:PropShape :hasSiblings (?pShape ?qShape ?siblist).
	?siblist list:iterate (?index ?value).
} => {
	{	?shape :targets ?i.   
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest). 
		?violation  sh:sourceShape ?value;
					sh:focusNode   ?toTest. 
	} => {
		:PropShape :qDShape (?i ?qShape ?value ?toTest).
	}.
#################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).	 
		?value :hasPChild (?pShape ?prop2).
		:PropShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :qDShape (?i ?qShape ?value ?toTest).
	}.
#################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).	 
		?value :hasPChild (?pShape ?prop2).
		:NodeShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :qDShape (?i ?qShape ?value ?toTest).
	}.
}.

{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape;
			sh:qualifiedValueShapesDisjoint true.
	?pShape sh:property ?shape.
} => {
	{	(_:dataScope 2) log:includes {?shape 	:targets 	?i.}.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		:PropShape :hasSiblings (?pShape ?qShape ?siblist).
		?siblist list:iterate (?index ?value).
		(?value {:PropShape :qDShape (?i ?qShape ?value ?toTest).} ?v2list) log:collectAllIn ?scope. 
		?v2list list:length ?lv2list.
		?siblist list:length ?lsiblist.
		?lv2list math:lessThan ?lsiblist.
	} =>{
		:PropShape :qDVShape (?i ?qShape ?siblist ?toTest).
	}
}.

{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape;
			sh:qualifiedMinCount ?min;
			sh:qualifiedValueShapesDisjoint true.
	?pShape sh:property ?shape.
} => {
	{	(_:dataScope 2) log:includes {?shape 	:targets 	?i.}.
		("Less than " ?min " values have shape " ?qShape) string:concatenation ?message. 
		(?toTest {:PropShape :PathCommunication (?shape ?i ?prop ?toTest).} ?plist) log:collectAllIn ?scope. 
		(?toTest {:PropShape :qShape (?i ?qShape ?toTest).} ?v1list) log:collectAllIn ?scope. 
		:PropShape :hasSiblings (?pShape ?qShape ?siblist).
		(?toTest {:PropShape :qDVShape (?i ?qShape ?siblist ?toTest).} ?v2list) log:collectAllIn ?scope. 
		(?v1list ?v2list) list:append ?vdlist.
		?vdlist list:removeDuplicates ?vlist.
		?plist list:length ?lplist.
		?vlist list:length ?lvlist.
		?lvlist math:negation ?nlvlist.
		(?lplist ?nlvlist) math:sum ?over.
		?over math:lessThan ?min.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:QualifiedMinCountConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:value 						?plist;
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}.
}.	
########################
{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape;
			sh:qualifiedMaxCount ?max;
			sh:qualifiedValueShapesDisjoint true.
	?pShape sh:property ?shape.
} => {
	{	(_:dataScope 2) log:includes {?shape 	:targets 	?i.}.
		("More than " ?max " values have shape " ?qShape) string:concatenation ?message. 
		(?toTest {:PropShape :PathCommunication (?shape ?i ?prop ?toTest).} ?plist) log:collectAllIn ?scope. 
		(?toTest {:PropShape :qShape (?i ?qShape ?toTest).} ?v1list) log:collectAllIn ?scope. 
		:PropShape :hasSiblings (?pShape ?qShape ?siblist).
		(?toTest {:PropShape :qDVShape (?i ?qShape ?siblist ?toTest).} ?v2list) log:collectAllIn ?scope. 
		(?v1list ?v2list) list:append ?vdlist.
		?vdlist list:removeDuplicates ?vlist.
		?plist list:length ?lplist.
		?vlist list:length ?lvlist.
		?lvlist math:negation ?nlvlist.
		(?lplist ?nlvlist) math:sum ?over.
		?over math:greaterThan ?max.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:QualifiedMaxCountConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:value 						?plist;
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}.
}.	
###########################case no father
{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape;
			sh:qualifiedMinCount ?min;
			sh:qualifiedValueShapesDisjoint true.
	_:shac log:notIncludes {?pShape sh:property ?shape.}.
} => {
	{	(_:dataScope 2) log:includes {?shape 	:targets 	?i.}.
		("Less than " ?min " values have shape " ?qShape) string:concatenation ?message. 
		(?toTest {:PropShape :PathCommunication (?shape ?i ?prop ?toTest).} ?plist) log:collectAllIn ?scope. 
		(?toTest {:PropShape :qShape (?i ?qShape ?toTest).} ?v1list) log:collectAllIn ?scope. 
		?plist list:length ?lplist.
		?vlist list:length ?lvlist.
		?lvlist math:negation ?nlvlist.
		(?lplist ?nlvlist) math:sum ?over.
		?over math:lessThan ?min.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:QualifiedMinCountConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:value 						?plist;
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}.
}.	
########################
{	?shape 	sh:path 	?prop; 
			sh:qualifiedValueShape ?qShape;
			sh:qualifiedMaxCount ?max;
			sh:qualifiedValueShapesDisjoint true.
	_:shac log:notIncludes {?pShape sh:property ?shape.}.
} => {
	{	(_:dataScope 2) log:includes {?shape 	:targets 	?i.}.
		("More than " ?max " values have shape " ?qShape) string:concatenation ?message. 
		(?toTest {:PropShape :PathCommunication (?shape ?i ?prop ?toTest).} ?plist) log:collectAllIn ?scope. 
		(?toTest {:PropShape :qShape (?i ?qShape ?toTest).} ?vlist) log:collectAllIn ?scope. 
		?plist list:length ?lplist.
		?vlist list:length ?lvlist.
		?lvlist math:negation ?nlvlist.
		(?lplist ?nlvlist) math:sum ?over.
		?over math:greaterThan ?max.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:QualifiedMaxCountConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:value 						?plist;
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}.
}.	

#---hasValue
{	?shape 	sh:path 	?prop; 
			sh:hasValue ?value
} => {
	{	?shape 	:targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?value).
	} => {
		:PropShape :hasV (?i ?value)
	}.
	###############################
	{	?shape 	:targets ?i.
		("Missing expected value " ?value) string:concatenation ?message. 
		_:dataScope log:notIncludes {:PropShape :hasV (?i ?value)}
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:HasValueConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:value 						?i;
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}
}.	
#---in
{	?shape 	sh:path ?prop; 
			sh:in 	?list
} => {
	{	?shape 	:targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?toTest list:in ?list
	} => {
		:PropShape :lPos (?toTest ?list)
	}.
	###############################
	{	?shape 	:targets ?i.
		("Value is not in " ?list) string:concatenation ?message. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		_:dataScope log:notIncludes {:PropShape :lPos (?toTest ?list)}
	} => {
		[ 	a 								sh:ValidationResult;
			sh:resultSeverity 				sh:Violation;  
			sh:sourceConstraintComponent 	sh:InConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage 				?message]
	}
}.	

#------Logical Constraints
#---and
{	?shape 	sh:path ?prop; 
			sh:and 	?list
} => {
	{	?shape :targets ?i.   
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value).		 
		?violation  sh:sourceShape ?value;
                    sh:focusNode   ?toTest. 
	} => {
		:PropShape :and (?value ?toTest ?list).
	}.
    #################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value).		 
		?value :hasPChild (?pShape ?prop2).
		:PropShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :and (?value ?toTest ?list).
	}.
	#################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value).		 
		?value :hasPChild (?pShape ?prop2).
		:NodeShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :and (?value ?toTest ?list).
	}.
	#################################
    {   ?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have all the shapes in " ?list) string:concatenation ?message. 
        (?value {:PropShape :and (?value ?toTest ?list).} ?vlist) log:collectAllIn ?scope. 
        ?vlist list:length ?vlength.
        ?vlength math:greaterThan 0
    } => {
        [ 	a 								sh:ValidationResult;
			sh:resultSeverity 				sh:Violation;
			sh:sourceConstraintComponent 	sh:AndConstraintComponent;
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:resultPath 					?prop;
			sh:value 						?toTest;
			sh:resultMessage 				?message]
    }.
	#####################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value) 
	} => {
		?value :targets ?toTest
	}
}.
#---or
{	?shape 	sh:path ?prop; 
			sh:or 	?list
} => {
	{	?shape :targets ?i.   
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value).		 
		?violation  sh:sourceShape ?value;
                    sh:focusNode   ?toTest. 
	} => {
		:PropShape :or (?value ?toTest ?list).
	}.
    #################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value).
		?value :hasPChild (?pShape ?prop2).
		:PropShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :or (?value ?toTest ?list).
	}.
	#################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value).
		?value :hasPChild (?pShape ?prop2).
		:NodeShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :or (?value ?toTest ?list).
	}.
    #################################
    {   ?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have at least one of the shapes in " ?list) string:concatenation ?message. 
        (?value {:PropShape :or (?value ?toTest ?list).} ?vlist) log:collectAllIn ?scope. 
        ?vlist list:length ?vlength.
        ?list list:length ?llength.
        ?vlength math:equalTo ?llength
    } => {
        [ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:OrConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:resultPath 					?prop;
			sh:value 						?toTest;
			sh:resultMessage 				?message]
    }.
	#################################
	{	?shape 	:targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value) 
	} => {
		?value :targets ?toTest
	}.
}.
#---xone
{	?shape 	sh:path		?prop;
			sh:xone 	?list
} => {
	{	?shape :targets ?i.   
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value).		 
		?violation  sh:sourceShape ?value;
                    sh:focusNode   ?toTest. 
	} => {
		:PropShape :xone (?value ?toTest ?list).
	}.
    #################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value).	
		?value :hasPChild (?pShape ?prop2).
		:NodeShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :xone (?value ?toTest ?list).
	}.
	#################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value).	
		?value :hasPChild (?pShape ?prop2).
		:PropShape :prop (?toTest ?pShape ?violation)
	} => {
		:PropShape :xone (?value ?toTest ?list).
	}.
    #################################
    {   ?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have only one of the shapes in " ?list) string:concatenation ?message. 
        (?value {:PropShape :xone (?value ?toTest ?list).} ?vlist) log:collectAllIn ?scope. 
        ?vlist list:length ?vlength.
        ?list list:length ?llength.
        ?vlength math:equalTo ?llength
    } => {
        [ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:XoneConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?toTest;
			sh:resultPath 					?prop;
			sh:value 						?toTest;
			sh:resultMessage 				?message]
    }.
	#################################
    {   ?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have only one of the shapes in " ?list) string:concatenation ?message.  
        (?value {:PropShape :xone (?value ?toTest ?list).} ?vlist) log:collectAllIn ?scope. 
        ?vlist list:length ?vlength.
        ?list list:length ?llength.
        (?llength -1) math:sum ?mllength.
        ?vlength math:lessThan ?mllength
    } => {
        [ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:XoneConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?toTest;
			sh:resultPath 					?prop;
			sh:value 						?toTest;
			sh:resultMessage 				?message]
    }.
	#####################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		?list list:iterate (?index ?value) 
	} => {
		?value :targets ?toTest
	}
}.
#---closed
{	?shape 	sh:path  		?prop;
			sh:closed 		true.
    _:shac log:notIncludes {?shape sh:ignoredProperties ?list}.
    (?props {?shape	sh:property ?value.
             ?value	sh:path   	?props      } ?plist) log:collectAllIn ?scope.
} => {
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
    	?toTest ?tprop ?something.
    	?plist list:member ?tprop.
    }=>{
      	:PropShape :closed (?plist ?toTest ?tprop)
    }.
  ########################
  	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value should be closed") string:concatenation ?message.
    	?toTest ?tprop ?something.
    	_:dataScope log:notIncludes {:PropShape :closed (?plist ?toTest ?tprop)}
    }=>{
      	[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:ClosedConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?toTest; 
			sh:value 						?something;
			sh:resultPath 					?tprop;
			sh:resultMessage 				?message]
   	}
}.
############################################################
{	?shape 	sh:path  ?prop;
			sh:closed true;
    		sh:ignoredProperties ?list.
    (?props {?shape	sh:property ?value.
             ?value	sh:path   	?props      } ?vplist) log:collectAllIn ?scope.
    (?vplist ?list) list:append ?plist.
} => {
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
    	?toTest ?tprop ?something.
    	?plist list:member ?tprop.
    }=>{
      	:PropShape :closed (?plist ?toTest ?tprop)
    }.
  ########################
  	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value should be closed") string:concatenation ?message.
    	?toTest ?tprop ?something.
    	_:dataScope log:notIncludes {:PropShape :closed (?plist ?toTest ?tprop)}
    }=>{
      	[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:ClosedConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?toTest; 
			sh:value 						?something;
			sh:resultPath 					?tprop;
			sh:resultMessage 				?message]
   	} 
}.