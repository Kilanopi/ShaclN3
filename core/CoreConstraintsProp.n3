	?shape :needs :Nodekind.
	##########################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value is not <= " ?value) string:concatenation ?message. 
		:testPos :literal ?toTest.
		_:dataScope log:notIncludes {?toTest math:equalTo ?toTest.}.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MaxInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?toTest;
			sh:resultPath 					?prop; 
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}.
	#########################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value is not <= " ?value) string:concatenation ?message. 
		:testNeg :literal ?toTest
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MaxInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?toTest;
			sh:resultPath 					?prop; 
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}
}.
#---minExclusive
{	?shape 	sh:path 		?prop; 
			sh:minExclusive ?value. 
} => {
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value is not > " ?value) string:concatenation ?message. 
		?toTest math:lessThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation;  
			sh:sourceConstraintComponent 	sh:MinExclusiveConstraintComponent; 
