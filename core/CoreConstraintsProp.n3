@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix func: <http://www.w3.org/2007/rif-builtin-function#>.

{
} => {
	{	?shape 	:needs :Nodekind;
			   	sh:path  ?prop. 
		_:shaclScope log:notIncludes {:please :apply :clean}
	} => {
		{	?shape :targets ?i.
			:PropShape :PathCommunication (?shape ?i ?prop ?toTest). 
			?toTest log:rawType log:Literal
		} => {
			:testPos :literal ?toTest.
			:testNeg :iri ?toTest.
			:testNeg :blanknode ?toTest.
		}.
		###############
		{	?shape :targets ?i.
			:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
			?toTest log:rawType log:Other
		} => {
			:testNeg :literal ?toTest.
			:testPos :iri ?toTest.
			:testNeg :blanknode ?toTest.
		}.
		###############
		{	?shape :targets ?i.
			:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
			?toTest log:rawType log:UnlabeledBlankNode
		} => {
			:testNeg :literal ?toTest.
			:testNeg :iri ?toTest.
			:testPos :blanknode ?toTest.
		}.
		###############
		{	?shape :targets ?i.
			:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
			?toTest log:rawType log:ForAll
		} => {
			:testNeg :literal ?toTest.
			:testNeg :iri ?toTest.
			:testPos :blanknode ?toTest.
		}.
		###############
		{	?shape :targets ?i.
			:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
			?toTest log:rawType log:LabeledBlankNode
		} => {
			:testNeg :literal ?toTest.
			:testNeg :iri ?toTest.
			:testPos :blanknode ?toTest.
		}.
		###############
		{	?shape :targets ?i.
			:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
			?toTest log:rawType log:SkolemIRI
		} => {
			:testNeg :literal ?toTest.
			:testNeg :iri ?toTest.
			:testPos :blanknode ?toTest.
		}.
	}
}.
#--------Core Constraint Components
#------Value Type Constraints
#---class
{	?shape sh:path  ?prop; 
           sh:class ?class
} => {
	{	?shape :targets ?i.
  	 	:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have class " ?class) string:concatenation ?message.
  		_:dataScope log:notIncludes {?toTest rdf:type ?class}
 	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity 				sh:Violation;
			sh:sourceConstraintComponent 	sh:ClassConstraintComponent;
			sh:sourceShape 					?shape;
			sh:focusNode 					?i; 
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage				?message]
	}
}.
#---datatype
{	?shape 	sh:path 	?prop; 
			sh:datatype ?type
} => {
	{	?shape  :targets 	?i.
  		("Value does not have datatype " ?type) string:concatenation ?message. 
  		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
  		(?data ?testType) log:dtlit ?toTest. 
  		?testType log:notEqualTo ?type
 	} => {
		[	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation;
			sh:sourceConstraintComponent 	sh:DatatypeConstraintComponent; 
			sh:sourceShape 					?shape;
  			sh:focusNode 					?i;  
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage 				?message]
 	}.
	
	###########################################
	?shape :needs :Nodekind.
	##########################################
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have datatype " ?type) string:concatenation ?message.
		:testNeg :literal ?toTest.
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:resultPath 					?prop; 
			sh:value						?toTest;
			sh:resultMessage				?message]
	}.
	########################################## Taken from eye/reasoning/ill-formed-literals
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
  		?toTest log:rawType log:Literal.
  		(?lex xsd:boolean) log:dtlit ?toTest.
  		?lex string:notMatches "^(true|false|1|0)$".
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:resultPath 					?prop; 
			sh:value						?toTest].
	}.
	##############
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
  		?toTest log:rawType log:Literal.
  		(?lex ?dt) log:dtlit ?toTest.
  		?dt list:in (
      	xsd:integer
      	xsd:long
      	xsd:int
      	xsd:short
      	xsd:byte
      	xsd:nonNegativeInteger
      	xsd:positiveInteger
      	xsd:nonPositiveInteger
      	xsd:negativeInteger
      	xsd:unsignedLong
      	xsd:unsignedInt
      	xsd:unsignedShort
      	xsd:unsignedByte ).
  		?lex string:notMatches "^[+-]?[0-9]+$".
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:resultPath 					?prop; 
			sh:value						?toTest].
	}.
	##############
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
  		?toTest log:rawType log:Literal.
		(?lex xsd:decimal) log:dtlit ?toTest.
  		?lex string:notMatches "^[+-]?(?:[0-9]+\\.[0-9]*|\\.[0-9]+|[0-9]+)$".
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:resultPath 					?prop; 
			sh:value						?toTest].
	}.
	##############
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
  		?toTest log:rawType log:Literal.
		(?lex ?dt) log:dtlit ?toTest.
  		?dt list:in ( xsd:float xsd:double ).
  		?lex string:notMatches "^(?:NaN|INF|-INF|[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)$".
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:resultPath 					?prop; 
			sh:value						?toTest].
	}.
	##############
	{	?shape :targets ?i.
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
  		?toTest log:rawType log:Literal.
		(?lex ?dt) log:dtlit ?toTest.
  		?dt list:in ( xsd:date xsd:dateTime xsd:duration ).
  		1 log:notIncludes { ?toTest math:equalTo ?toTest. }.
	} => {
		[	a 								sh:ValidationResult;
			sh:resultSeverity				sh:Violation;
			sh:sourceConstraintComponent	sh:DatatypeConstraintComponent;
			sh:sourceShape					?shape;
			sh:focusNode					?i;
			sh:resultPath 					?prop; 
			sh:value						?toTest].
	}.
}.	
#---nodeKind
{	?shape 	sh:path 	?prop; 
			sh:nodeKind ?kind
} => {
	?shape :needs :Nodekind.
	################################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:Literal.
		:testNeg :literal ?toTest
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:BlankNode.
		:testNeg :blanknode ?toTest
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:IRI.
		:testNeg :iri ?toTest
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:BlankNodeOrLiteral.
		:testPos :iri ?toTest
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:IRIOrLiteral.
		:testPos :blanknode ?toTest
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage 				?message]
	}.
	################################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value does not have node kind " ?kind) string:concatenation ?message. 
		?kind log:equalTo sh:BlankNodeOrIRI.
		:testPos :literal ?toTest
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:NodeKindConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage 				?message]
	}.
}.

#------Cardinality Constraints
#---minCount
{	?shape  sh:path 	?prop; 
			sh:minCount ?amount
} => {
	{	?shape :targets ?i.
		("Less than " ?amount " values") string:concatenation ?message. 
		(?toTest {:PropShape :PathCommunication (?shape ?i ?prop ?toTest).} ?list) log:collectAllIn ?scope.
		?list list:length ?llength. 
		?llength math:lessThan ?amount
	} => {
		[ 	a 								sh:ValidationResult;
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinCountConstraintComponent;
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:value 						?list; 
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}
}.	
#---maxCount
{	?shape 	sh:path 	?prop; 
			sh:maxCount ?amount
} => {
	{	?shape 	:targets ?i.
		("More than " ?amount " values") string:concatenation ?message. 
		(?toTest {:PropShape :PathCommunication (?shape ?i ?prop ?toTest)} ?list) log:collectAllIn ?scope. 
		?list list:length ?llength. 
		?llength math:greaterThan ?amount
	} => {
		[ 	a 								sh:ValidationResult;
			sh:resultSeverity 				sh:Violation;  
			sh:sourceConstraintComponent 	sh:MaxCountConstraintComponent;
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:value 						?list;
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}
}.
#------Value Range Constraints
#---minInclusive
{	?shape 	sh:path 			?prop; 
		   	sh:minInclusive 	?value
} => {
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value is not >= " ?value) string:concatenation ?message. 
		(?value ?toTest) func:subtract-dateTimes ?result.
		?result string:startsWith "-".
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?toTest;
			sh:resultPath 					?prop; 
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}.
	##########################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value is not >= " ?value) string:concatenation ?message. 
		?toTest math:lessThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?toTest;
			sh:resultPath 					?prop; 
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}.
	##########################
	?shape :needs :Nodekind.
	##########################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value is not >= " ?value) string:concatenation ?message. 
		:testPos :literal ?toTest.
		_:dataScope log:notIncludes {?toTest math:equalTo ?toTest.}.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?toTest;
			sh:resultPath 					?prop; 
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}.
	#########################
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value is not >= " ?value) string:concatenation ?message. 
		:testNeg :literal ?toTest
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MinInclusiveConstraintComponent; 
			sh:sourceShape 					?shape; 
			sh:value 						?toTest;
			sh:resultPath 					?prop; 
			sh:focusNode 					?i; 
			sh:resultMessage 				?message]
	}
}.
#---maxInclusive
{	?shape 	sh:path 			?prop; 
		   	sh:maxInclusive 	?value
} => {
	{	?shape :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		("Value is not <= " ?value) string:concatenation ?message. 
		?toTest math:greaterThan ?value.
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:MaxInclusiveConstraintComponent; 
