#---languageIn																			
{	?shape 	sh:path 		?prop; 
			sh:languageIn 	?list
} => {
	{	?shape  :targets ?i. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		(?something ?tag) log:langlit ?toTest. 
		?list list:iterate (?index ?value). 
		("^(" ?value "-+.*)|(" ?value ")$") string:concatenation ?regex. 					# ^(?value-+.*)|(?value)$ 
		?tag string:matches ?regex
	} => {
		:PropShape :langPos (?toTest ?list)
	}.
	##########																
	{	?shape  :targets ?i. 
		("Language does not match any of " ?list) string:concatenation ?message. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		_:dataScope log:notIncludes {:PropShape :langPos (?toTest ?list)}
	} => {
		[ 	a 								sh:ValidationResult; 
			sh:resultSeverity 				sh:Violation;
			sh:sourceConstraintComponent 	sh:LanguageInConstraintComponent;
			sh:sourceShape 					?shape; 
			sh:focusNode 					?i; 
			sh:resultPath 					?prop; 
			sh:value 						?toTest;
			sh:resultMessage 				?message]
	}
}.	
#---uniqueLang
{	?shape  sh:path 		?prop; 
			sh:uniqueLang 	?bool.
	?bool log:rawType log:Literal.
  	(?lex xsd:boolean) log:dtlit ?bool.
  	?lex string:notMatches "^(0|false)$".
} => {
	{	?shape 	:targets ?i.
		("Language " ?tag1 " has been used more than once") string:concatenation ?message. 
		:PropShape :PathCommunication (?shape ?i ?prop ?toTest).
		:PropShape :PathCommunication (?shape ?i ?prop ?otherTest).
		?toTest log:notEqualTo ?otherTest.  
		(?str1 ?tag1) log:langlit ?toTest. 
		(?str2 ?tag2) log:langlit ?otherTest. 
		?tag1 string:equalIgnoringCase ?tag2
	} => {
		[ 	a 								sh:ValidationResult;
			sh:resultSeverity 				sh:Violation; 
			sh:sourceConstraintComponent 	sh:UniqueLangConstraintComponent; 
			sh:sourceShape 					?shape;
			sh:focusNode 					?i;
			sh:resultPath 					?prop;
			sh:resultMessage 				?message]
	}
}.	
